      "ai_languageModel": [[{ "node": "F&B Research Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "SerpAPI Web Search": {
      "ai_tool": [[{ "node": "F&B Research Agent", "type": "ai_tool", "index": 0 }]]
    },
