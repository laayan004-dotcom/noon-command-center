      "main": [[{ "node": "Parse Successful?", "type": "main", "index": 0 }]]
    },
    "Handle Agent Error": {
      "main": [[{ "node": "Parse Successful?", "type": "main", "index": 0 }]]
    },
    "Parse Successful?": {
      "main": [
        [{ "node": "Write Research to Notion", "type": "main", "index": 0 }],
        [{ "node": "Flag for Manual Review", "type": "main", "index": 0 }]
      ]
    },
    "Write Research to Notion": {
      "main": [[{ "node": "Rate Limit (3s)", "type": "main", "index": 0 }]]
    },
    "Flag for Manual Review": {
      "main": [[{ "node": "Rate Limit (3s)", "type": "main", "index": 0 }]]
    },
    "Rate Limit (3s)": {
      "main": [[{ "node": "Loop Over Restaurants", "type": "main", "index": 0 }]]
    }
  },

  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },

  "staticData": null,
  "meta": { "templateCredsSetupCompleted": true },
  "pinData": {},
